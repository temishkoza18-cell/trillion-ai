    "desktop": "npm run build && .venv\\Scripts\\python.exe -m backend.desktop"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "vite": "^6.4.1"
  },
