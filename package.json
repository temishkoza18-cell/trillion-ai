{
  "name": "trillion-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first, extensible voice-first AI co-founder.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start:api": ".venv\\Scripts\\python.exe -m uvicorn backend.app:app --host 127.0.0.1 --port 8765",
